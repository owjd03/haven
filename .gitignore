.appcheck-debug-token*
appcheck-debug-token*

# Firebase CLI
.firebase/
firebase-debug.log*

# Hotline scraper tooling (raw downloads + venv are not committed)
tools/hotlines/.venv/
tools/hotlines/raw/
__pycache__/

# Screenshot tool output (the script in tools/shots is kept)
tools/shots/*.png
